 @dataclass
+class MoveRow:
+    date: str
+    team: str
+    player: str
+    direction: str   # "acquired" (claims) or "relinquished" (waived / released / bought out)
+    move_type: str   # claimed / buyout / waived / released / contract_voided
+    raw_notes: str
+
+
+def _clean_cell(cell: str) -> str:
+    cell = str(cell)
+    return "" if cell.strip().lower() in ("", "nan", "none") else cell
+
+
+def move_rows_from_dataframe(df: pd.DataFrame) -> list[MoveRow]:
+    """Waiver claims and roster exits that rows_from_dataframe discards.
+    Kept separate so the contract/trade buckets are byte-for-byte unchanged."""
+    out: list[MoveRow] = []
+    for _, r in df.iterrows():
+        notes = str(r["Notes"])
+        if CONTRACT_KEYWORDS.search(notes) or TRADE_KEYWORDS.search(notes):
+            continue
+        move_type = next((name for name, rx in MOVE_TYPES if rx.search(notes)), None)
+        if move_type is None:
+            continue
+        acquired, relinquished = _clean_cell(r["Acquired"]), _clean_cell(r["Relinquished"])
+        direction = "acquired" if acquired and not relinquished else "relinquished"
+        for player in extract_assets(acquired if direction == "acquired" else relinquished):
+            out.append(MoveRow(date=str(r["Date"]), team=str(r["Team"]), player=player,
+                               direction=direction, move_type=move_type, raw_notes=notes))
+    return out
+
